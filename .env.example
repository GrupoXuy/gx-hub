# Banco de dados PostgreSQL (Neon, Supabase, Render, Railway etc.)
# Cole o "Direct connection string" (Neon) ou "Session pooler" aqui.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Opcional — servidor TURN para chamadas em redes corporativas restritivas
# Obtenha um serviço gratuito em: https://global.stunproject.org/turn/ ou Twilio
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
